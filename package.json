{
  "name": "project1",
  "version": "0.0.1",
  "description": "An SAP Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {
    "@cap-js/hana": "^3.0.2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10.0.5",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.0.2",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "@sap-ux/ui5-middleware-fe-mockserver": "2",
    "@sap/cds-dk": "^10.0.6",
    "@sap/ux-ui5-tooling": "1",
    "@ui5/cli": "^4.0.33",
    "cds-plugin-ui5": "^0.17.0",
    "eslint": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint ./",
    "start-mock": "fiori run --config ./ui5-mock.yaml --open \"test/flp.html#app-preview\"",
    "deploy": "fiori verify",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open \"/index.html?sap-ui-xx-viewCache=false\"",
    "start-variants-management": "fiori run --open \"/preview.html#app-preview\"",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "sapux": [
    "app/project1"
  ],
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "display-user": {
              "password": "display",
              "roles": [
                "ZNW_ORD_DISPLAY"
              ]
            },
            "coord-user": {
              "password": "coord",
              "roles": [
                "ZNW_ORD_COORD"
              ]
            },
            "analyst-user": {
              "password": "analyst",
              "roles": [
                "ZNW_ORD_ANALYST"
              ]
            },
            "no-role-user": {
              "password": "test",
              "roles": []
            }
          }
        }
      },
      "Northwind": {
        "kind": "odata-v2",
        "model": "srv/external/Northwind"
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "Northwind": {
          "credentials": {
            "destination": "NORTHWIND"
          }
        }
      },
      "html5-repo": true
    }
  },
  "workspaces": [
    "app/*"
  ]
}
