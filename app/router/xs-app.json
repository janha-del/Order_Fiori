{
  "welcomeFile": "/project1/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/order-workbench/(.*)$",
      "target": "/order-workbench/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^(/.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}